# Senhas administrativas do portfólio e contas internas.
PORTFOLIO_ADMIN_PASSWORD=
PORTFOLIO_ADMIN_EMAIL=
PORTFOLIO_STUDENT_PASSWORD=

# Vercel Blob legado: portfólio e recursos existentes.
BLOB_READ_WRITE_TOKEN=

# Vercel Blob privado: compras, contas e links de acesso da Cakto.
CAKTO_BLOB_READ_WRITE_TOKEN=

# Cakto: configure a mesma chave secreta no webhook e na variável de produção.
CAKTO_WEBHOOK_SECRET=
CAKTO_FORMATOS_PRODUCT_SHORT_ID=35i4ijs
CAKTO_FORMATOS_PRODUCT_ID=
CAKTO_FORMATOS_CHECKOUT_URL=https://pay.cakto.com.br/35i4ijs_1256672
CAKTO_PROMPTSMOTION_PRODUCT_SHORT_ID=
CAKTO_PROMPTSMOTION_PRODUCT_ID=
CAKTO_LEGENDAS_PRODUCT_SHORT_ID=
CAKTO_LEGENDAS_PRODUCT_ID=

# Resend: remetente do domínio verificado para convites e links de acesso.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Aymar Labs <acesso@aymarlabs.com.br>
APP_URL=https://www.aymarlabs.com.br

# E-mails internos com acesso administrativo a 50 Formatos, separados por vírgula.
FORMATOS_ACCESS_EMAILS=contatos.aymar@gmail.com
